# ==============================================================================
# Life Goals AI Frontend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development overrides.
# Never commit real API keys, tokens, or credentials to source control.

# Base URL pointing to the Flask REST API (v1 prefix included)
# Development local default:
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1
# Production example:
# VITE_API_BASE_URL=https://api.lifegoals.ai/api/v1

# Network request timeout in milliseconds (default: 15000ms / 15 seconds)
VITE_API_TIMEOUT_MS=15000

# Explicit Mock Mode toggle for offline UI prototyping
# Strictly ignored in production environments (never active when PROD=true)
VITE_USE_MOCK_API=false

# ==============================================================================
# Firebase Client SDK Configuration (Client-safe public config)
# ==============================================================================
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=AIzaSyYourClientApiKeyPlaceholder
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Local Firebase Auth Emulator Host for development
# Uncomment when running `firebase emulators:start --only auth`
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
