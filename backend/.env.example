# ==============================================================================
# Life Goals AI - Backend Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit real API keys, passwords, service account keys, or tokens
# to version control. Copy this file to .env and provide your secrets locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Options: development, testing, production
FLASK_ENV=development

# Entrypoint configuration
FLASK_APP=run.py
FLASK_DEBUG=false

# Local server binding
HOST=127.0.0.1
PORT=5000

# ------------------------------------------------------------------------------
# 2. Security & Cryptography
# ------------------------------------------------------------------------------
# Development placeholder. In production, provide a cryptographically secure random key
# (e.g. generated via: python -c "import secrets; print(secrets.token_hex(32))").
# Production requires at least 32 characters.
SECRET_KEY=dev-secret-key-life-goals-ai-change-this-in-production-env

# ------------------------------------------------------------------------------
# 3. CORS Policy (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g., Vite dev server, production domain).
# NOTE: Wildcards ('*') are strictly disallowed in production or when credentials are true.
# CORS alone does NOT replace authentication or authorization!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_SUPPORTS_CREDENTIALS=true

# ------------------------------------------------------------------------------
# 4. Request Limits & Protection
# ------------------------------------------------------------------------------
# Maximum request body size in bytes (1048576 = 1MB). Protects against payload flooding.
MAX_CONTENT_LENGTH_BYTES=1048576

# ------------------------------------------------------------------------------
# 5. External Integrations & Timeouts (Seconds)
# ------------------------------------------------------------------------------
# Default timeout for standard HTTP API integrations
EXTERNAL_TIMEOUT_SECONDS=10.0

# Timeout for long-running AI / LLM orchestration requests
AI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Usage Quotas
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 7. Health & Readiness Behavior
# ------------------------------------------------------------------------------
# Set to 'true' in production if the service must fail readiness when Firebase is unconfigured.
# Kept 'false' during development/testing so the server runs without cloud credentials.
HEALTH_REQUIRE_FIREBASE=false

# ------------------------------------------------------------------------------
# 8. Observability & Logging
# ------------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to true for JSON-structured logs (recommended for production/containers)
JSON_LOGS=false

# ------------------------------------------------------------------------------
# 9. Firebase Admin & Cloud Firestore (Cloud Credentials)
# ------------------------------------------------------------------------------
# Optional for local health checks and testing. Required for Firestore persistence.
# Never commit the service account JSON file to git.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# ------------------------------------------------------------------------------
# 10. Firebase Local Emulator Suite (Optional for Local Offline Development)
# ------------------------------------------------------------------------------
# When running `firebase emulators:start`, uncomment these to route all Auth
# and Firestore traffic to the local emulator instances with zero cloud costs.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
